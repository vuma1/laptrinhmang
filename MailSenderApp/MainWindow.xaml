<Window x:Class="MailSenderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Gửi Email Tự Động — SMTP Mail Sender (C# WPF .NET 8)"
        Height="800" Width="1150"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Tabs -->
            <RowDefinition Height="Auto"/>  <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             HEADER
             ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✉" FontSize="24" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="HỆ THỐNG GỬI EMAIL TỰ ĐỘNG" Foreground="White"
                                   FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="#94A3B8" FontSize="12" Margin="34,2,0,0"
                               Text="Đề tài 5 — Môn Lập Trình Mạng 2026 | Giao thức SMTP | C# WPF .NET 8"/>
                </StackPanel>

                <!-- Badge server -->
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="20" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotStatus" Width="10" Height="10"
                                 Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TbServerBadge" Text="smtp.gmail.com : 587"
                                   Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             TABS
             ══════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Margin="14,10,14,6"
                    Background="Transparent" BorderThickness="0">

            <!-- ┌──────────────────────────────────────────┐ -->
            <!-- │  TAB 1 : SOẠN & GỬI THƯ                 │ -->
            <!-- └──────────────────────────────────────────┘ -->
            <TabItem Header="  ✉  Soạn &amp; Gửi Thư  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: form soạn thư -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="18" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Thông Tin Email" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextMain}" Margin="0,0,0,14"/>

                                <Label Content="Người nhận (To) — nhiều email cách nhau bởi dấu phẩy:"/>
                                <TextBox x:Name="TbTo"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="CC (Đồng kính gửi):"/>
                                        <TextBox x:Name="TbCc"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="BCC (Kính gửi ẩn):"/>
                                        <TextBox x:Name="TbBcc"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Tiêu đề (Subject):"/>
                                        <TextBox x:Name="TbSubject"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Mẫu thư nhanh:"/>
                                        <ComboBox x:Name="CbTemplate" SelectionChanged="CbTemplate_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                    <CheckBox x:Name="ChkHtml" Content="Gửi dạng HTML" IsChecked="True"
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="   Độ ưu tiên:" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                    <ComboBox x:Name="CbPriority" Width="120" Margin="6,0,0,0" SelectedIndex="1">
                                        <ComboBoxItem Content="Thấp (Low)"/>
                                        <ComboBoxItem Content="Bình thường"/>
                                        <ComboBoxItem Content="Cao (High)"/>
                                    </ComboBox>
                                </StackPanel>

                                <Label Content="Nội dung thư:"/>
                                <TextBox x:Name="TbBody" Height="230" AcceptsReturn="True"
                                         AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas, Segoe UI" FontSize="13"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="Xóa trắng" Style="{StaticResource BtnSecondary}"
                                            Click="BtnClear_Click" Margin="0,0,10,0" Width="90"/>
                                    <Button x:Name="BtnSend" Content="🚀  Gửi Thư Ngay"
                                            Click="BtnSend_Click" Width="140" Padding="16,9"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Cột phải: đính kèm + tip -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="📎 Tệp Đính Kèm" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="Kéo thả hoặc bấm Thêm Tệp (tối đa ~25 MB/mail)"
                                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ListBox Grid.Row="1" x:Name="LbAttach"
                                         Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}"
                                         AllowDrop="True" Drop="LbAttach_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📄 " VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="✕"
                                                        Tag="{Binding}" Click="BtnRemoveAttach_Click"
                                                        Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                                        FontWeight="Bold" Padding="4,2" BorderThickness="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Xóa hết" Style="{StaticResource BtnDanger}"
                                            Click="BtnClearAttach_Click" Margin="0,0,8,0"/>
                                    <Button Content="+ Thêm Tệp…" Click="BtnAddAttach_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tip card -->
                        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8"
                                BorderBrush="#BFDBFE" BorderThickness="1" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 Kiến thức SMTP (RFC 5321)" FontWeight="Bold"
                                           Foreground="#1E40AF" FontSize="13"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1E3A8A" Margin="0,5,0,0"
                                           Text="• Client kết nối Socket TCP đến cổng 587 → gửi lệnh EHLO → STARTTLS → AUTH LOGIN → MAIL FROM → RCPT TO → DATA → QUIT.&#x0a;• Ứng dụng dùng async/await nên UI không bị treo khi gửi file lớn."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ┌──────────────────────────────────────────┐ -->
            <!-- │  TAB 2 : GỬI HÀNG LOẠT TỰ ĐỘNG         │ -->
            <!-- └──────────────────────────────────────────┘ -->
            <TabItem Header="  🚀  Gửi Hàng Loạt Tự Động  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📂 Nạp CSV / TXT" Click="BtnImport_Click" Margin="0,0,10,0"/>
                                <Button Content="📄 Dữ Liệu Mẫu" Style="{StaticResource BtnSecondary}"
                                        Click="BtnSampleData_Click" Margin="0,0,20,0"/>
                                <TextBlock Text="Khoảng trễ:" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CbDelay" Width="130" SelectedIndex="1">
                                    <ComboBoxItem Content="0s — Tức thì"/>
                                    <ComboBoxItem Content="2s — Khuyên dùng"/>
                                    <ComboBoxItem Content="5s"/>
                                    <ComboBoxItem Content="10s"/>
                                    <ComboBoxItem Content="30s"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnStartBulk" Content="▶  Bắt Đầu Gửi Hàng Loạt"
                                        Style="{StaticResource BtnSuccess}" Click="BtnStartBulk_Click"
                                        Padding="16,8" Margin="0,0,10,0"/>
                                <Button x:Name="BtnStopBulk" Content="⏹ Dừng Lại"
                                        Style="{StaticResource BtnDanger}" Click="BtnStopBulk_Click"
                                        IsEnabled="False" Padding="14,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nội dung giữa -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid người nhận -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Padding="12" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <TextBlock Text="Danh Sách Người Nhận" FontSize="15"
                                               FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="TbStats" Foreground="{StaticResource TextMuted}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" x:Name="DgRecipients" AutoGenerateColumns="False"
                                          CanUserAddRows="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          Background="White" RowHeight="30" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT"   Binding="{Binding STT}"   Width="42"/>
                                        <DataGridTextColumn Header="Họ Tên" Binding="{Binding Name}"  Width="130"/>
                                        <DataGridTextColumn Header="Email"  Binding="{Binding Email}" Width="170"/>
                                        <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Note}" Width="120"/>
                                        <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="✓ Thành công">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="Text" Value="✗ Thất bại">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </Trigger>
                                                                    <Trigger Property="Text" Value="Đang gửi...">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Lúc"   Binding="{Binding SentAt}"  Width="64"/>
                                        <DataGridTextColumn Header="Phản hồi" Binding="{Binding Note2}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Template cá nhân hóa -->
                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Mẫu Thư Cá Nhân Hóa" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Các thẻ thay thế tự động:" FontSize="12"
                                           Foreground="{StaticResource TextMuted}" Margin="0,3,0,6"/>
                                <WrapPanel>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="7,3" Margin="0,0,5,4">
                                        <TextBlock Text="{}{Name}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="7,3" Margin="0,0,5,4">
                                        <TextBlock Text="{}{Email}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="7,3" Margin="0,0,5,4">
                                        <TextBlock Text="{}{Note}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="7,3" Margin="0,0,5,4">
                                        <TextBlock Text="{}{Date}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                    </Border>
                                </WrapPanel>

                                <Label Content="Tiêu đề mẫu:" Margin="0,8,0,0"/>
                                <TextBox x:Name="TbBulkSubject"
                                         Text="[Thông báo] Xin chào {Name}!"/>

                                <Label Content="Nội dung mẫu (HTML):" Margin="0,10,0,0"/>
                                <TextBox x:Name="TbBulkBody" Height="230"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas, Segoe UI" FontSize="12">
                                    <TextBox.Text>&lt;h2&gt;Xin chào &lt;b&gt;{Name}&lt;/b&gt;,&lt;/h2&gt;
&lt;p&gt;Hệ thống tự động gửi thông báo đến địa chỉ &lt;i&gt;{Email}&lt;/i&gt; của bạn.&lt;/p&gt;
&lt;p&gt;Ghi chú: &lt;b&gt;{Note}&lt;/b&gt;&lt;/p&gt;
&lt;p&gt;Ngày: &lt;b&gt;{Date}&lt;/b&gt;&lt;/p&gt;
&lt;hr/&gt;
&lt;p&gt;Trân trọng,&lt;br/&gt;&lt;b&gt;Ban Quản Trị&lt;/b&gt;&lt;/p&gt;</TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Progress bar -->
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="14,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,5">
                                <TextBlock x:Name="TbProgress" Text="Tiến độ: chờ khởi động…"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="TbCurrent" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" x:Name="PbBulk" Height="13"
                                         Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ┌──────────────────────────────────────────┐ -->
            <!-- │  TAB 3 : CẤU HÌNH SMTP                  │ -->
            <!-- └──────────────────────────────────────────┘ -->
            <TabItem Header="  ⚙  Cấu Hình SMTP  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="22" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Thiết Lập Máy Chủ SMTP" FontSize="16"
                                           FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock Text="Cấu hình giao thức SMTP gửi mail ra Internet hoặc mạng nội bộ LAN."
                                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,18"/>

                                <Label Content="Chọn cấu hình nhanh (Preset):"/>
                                <ComboBox x:Name="CbPreset" SelectionChanged="CbPreset_Changed" Margin="0,0,0,14">
                                    <ComboBoxItem Content="Google Gmail — smtp.gmail.com : 587 — TLS On"/>
                                    <ComboBoxItem Content="Microsoft Outlook / Office 365 — smtp.office365.com : 587 — TLS On"/>
                                    <ComboBoxItem Content="Yahoo Mail — smtp.mail.yahoo.com : 587 — TLS On"/>
                                    <ComboBoxItem Content="Mạng LAN / Localhost — localhost : 25 — TLS Off"/>
                                    <ComboBoxItem Content="Tùy chỉnh (Custom)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Địa chỉ SMTP Server (Host / IP):"/>
                                        <TextBox x:Name="TbServer" Text="smtp.gmail.com"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Cổng (Port):"/>
                                        <TextBox x:Name="TbPort" Text="587"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="ChkSsl" Content="Bật mã hóa TLS / SSL"
                                          IsChecked="True" FontWeight="SemiBold" Margin="0,4,0,12"/>

                                <Label Content="Tên hiển thị người gửi:"/>
                                <TextBox x:Name="TbDisplayName" Text="Mail Sender App" Margin="0,0,0,12"/>

                                <Label Content="Email người gửi:"/>
                                <TextBox x:Name="TbEmail" Margin="0,0,0,12"/>

                                <Label Content="Mật khẩu ứng dụng (App Password):"/>
                                <PasswordBox x:Name="PbPass" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnTest" Content="🔌  Kiểm Tra Kết Nối"
                                            Style="{StaticResource BtnSecondary}"
                                            Click="BtnTest_Click" Margin="0,0,10,0"/>
                                    <Button Content="💾  Lưu Cấu Hình" Click="BtnSaveCfg_Click" Width="140"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Hướng dẫn -->
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="20" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📖 Hướng Dẫn &amp; Kiến Thức SMTP" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,12"/>

                                <Border Background="#FEF3C7" CornerRadius="7"
                                        BorderBrush="#FCD34D" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Gmail — App Password" FontWeight="Bold"
                                                   Foreground="#92400E" FontSize="13"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#78350F" FontSize="12" Margin="0,6,0,0"
                                                   Text="1. Bật 2-Step Verification trong tài khoản Google.&#x0a;2. Vào myaccount.google.com/apppasswords&#x0a;3. Tạo App Password (16 ký tự).&#x0a;4. Dán vào ô Mật khẩu ứng dụng bên trái."/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Các cổng SMTP phổ biến:" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" Margin="0,4,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="• Cổng 25: SMTP không mã hóa (dùng trong LAN).&#x0a;• Cổng 587: SMTP + STARTTLS (khuyên dùng cho Internet).&#x0a;• Cổng 465: SMTPS — SSL/TLS ngay từ đầu kết nối."/>

                                <Separator Margin="0,14"/>

                                <TextBlock Text="Luồng hoạt động SMTP:" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#2563EB" TextWrapping="Wrap"
                                           Text="WPF App ──TCP:587──► smtp.gmail.com ──► DNS MX Lookup ──► Mail Server Đích ──► Hòm thư người nhận"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ┌──────────────────────────────────────────┐ -->
            <!-- │  TAB 4 : LỊCH SỬ GỬI MAIL               │ -->
            <!-- └──────────────────────────────────────────┘ -->
            <TabItem Header="  📜  Lịch Sử  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Tìm kiếm:" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbSearch" Width="260" Margin="6,0"
                                         TextChanged="TbSearch_Changed"/>
                                <Button Content="↺ Làm Mới" Style="{StaticResource BtnSecondary}"
                                        Click="BtnRefresh_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="📥 Xuất CSV" Style="{StaticResource BtnSecondary}"
                                        Click="BtnExport_Click" Margin="0,0,10,0"/>
                                <Button Content="🗑 Xóa Hết" Style="{StaticResource BtnDanger}"
                                        Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10">
                        <DataGrid x:Name="DgHistory" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Background="White" RowHeight="30" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã"          Binding="{Binding Id}"          Width="72"/>
                                <DataGridTextColumn Header="Thời Gian"   Binding="{Binding TimeStr}"     Width="135"/>
                                <DataGridTextColumn Header="Người Gửi"   Binding="{Binding Sender}"      Width="160"/>
                                <DataGridTextColumn Header="Người Nhận"  Binding="{Binding To}"          Width="180"/>
                                <DataGridTextColumn Header="Tiêu Đề"     Binding="{Binding Subject}"     Width="*"/>
                                <DataGridTextColumn Header="Đính Kèm"    Binding="{Binding Attachments}" Width="75"/>
                                <DataGridTemplateColumn Header="Kết Quả" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="✓ Thành công">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="✗ Thất bại">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Chi Tiết Lỗi" Binding="{Binding Error}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,7">
            <Grid>
                <TextBlock x:Name="TbStatus" Text="Sẵn sàng." Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Text="Lập Trình Mạng 2026 — C# WPF .NET 8 — SMTP Protocol"
                           HorizontalAlignment="Right" Foreground="#475569" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
